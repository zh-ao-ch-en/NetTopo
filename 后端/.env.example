# 数据库连接串。默认 SQLite（本地零依赖）；换 MySQL 时改为下面这行并安装 pymysql：
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/lab
DATABASE_URL=sqlite:///./lab.db

# JWT 密钥（生产环境务必修改）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173